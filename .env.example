NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# The Vercel Supabase integration injects these automatically.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Manual/legacy fallback names, if the integration is not used:
# SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-legacy-anon-key

# Email delivery
RESEND_API_KEY=re_replace-with-api-key
RESEND_FROM="Anti-Phishing <security@example.com>"
