NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# The Vercel Supabase integration injects these automatically.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
SUPABASE_SUBMISSION_ASSETS_BUCKET=submission-assets

# Manual/legacy fallback names, if the integration is not used:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Admin access
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Email delivery
RESEND_API_KEY=re_replace-with-api-key
RESEND_FROM="Anti-Phishing <security@example.com>"
