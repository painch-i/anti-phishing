    "react-dom": "^19.1.0",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.3.5",
    "pg": "^8.23.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
